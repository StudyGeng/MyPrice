<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/setbudget_w"
    android:orientation="vertical"
    tools:context=".SetBudget">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99FFFFFF"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="343dp"
            android:layout_height="78dp"
            android:layout_gravity="center"
            android:layout_marginTop="35dp"
            app:cardBackgroundColor="#89FF00"
            app:cardCornerRadius="15dp">

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="5dp"
                android:text="Welcome To"
                android:textColor="#000000"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/lbl_storename_sb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center|center_horizontal"
                android:layout_marginTop="10dp"
                android:text="Store Name"
                android:textColor="#000000"
                android:textSize="30sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="341dp"
                android:layout_height="335dp"
                android:layout_gravity="center"
                android:layout_marginBottom="100dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imageView2"
                        android:layout_width="109dp"
                        android:layout_height="102dp"
                        android:layout_gravity="center|top"
                        android:layout_marginTop="30dp"
                        app:srcCompat="@drawable/img_2" />

                    <EditText
                        android:id="@+id/txt_budget_sb"
                        android:layout_width="225dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:defaultFocusHighlightEnabled="false"
                        android:ems="10"
                        android:focusedByDefault="true"
                        android:gravity="center"
                        android:hint="Set Your Budget"
                        android:inputType="numberDecimal"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/textView10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="Start shopping as:" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/CG_sb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/c_NonMember_sb"
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:checked="false"
                            android:text="Non-Member"
                            android:textAlignment="center"
                            android:textSize="16sp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/c_Member_sb"
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:checkable="true"
                            android:text="Member"
                            android:textAlignment="center"
                            android:textSize="16sp"
                            android:textStyle="normal" />

                    </com.google.android.material.chip.ChipGroup>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_next_sb"
                        android:layout_width="160dp"
                        android:layout_height="45dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="15dp"
                        android:layout_marginBottom="30dp"
                        android:background="@drawable/button5"
                        android:backgroundTint="#89FF00"
                        android:text="Next"
                        android:textSize="20sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
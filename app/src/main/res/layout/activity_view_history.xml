<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ViewHistory">

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            app:cardBackgroundColor="#89FF00">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_back_history"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center|left"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:background="@drawable/ic_baseline_arrow_back_24" />

            <TextView
                android:id="@+id/textView7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="History"
                android:textColor="@color/black"
                android:textSize="24sp"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_menu_history"
                android:layout_width="35dp"
                android:layout_height="35dp"
                android:layout_gravity="center|right"
                android:layout_marginRight="5dp"
                android:layout_weight="1"
                android:background="#00FA0000" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_menu_itemdetail3"
                android:layout_width="5dp"
                android:layout_height="35dp"
                android:layout_gravity="center|right"
                android:layout_marginRight="20dp"
                android:background="@drawable/ic_baseline_menu_24" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="40"
            android:background="@drawable/setbudget_w"
            android:orientation="vertical">

            <ListView
                android:id="@+id/listview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="40"
                android:background="#9AFFFFFF"
                tools:listitem="@layout/history_list">

            </ListView>
        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_emptyhistory_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="72dp"
        android:layout_marginBottom="980dp"
        android:text="There is nothing inside your history.."
        android:textColor="@color/black"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout2"
        app:layout_constraintVertical_bias="0.44" />

</androidx.constraintlayout.widget.ConstraintLayout>